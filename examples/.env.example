# =========================
# OpenAI 配置
# =========================
# 必填：OpenAI API Key
OPENAI_API_KEY=your-openai-api-key
# 选填：OpenAI 兼容网关地址，留空表示使用官方默认地址
OPENAI_BASE_URL=
# 选填：聊天模型，留空将使用示例脚本默认值 gpt-4o
OPENAI_MODEL=gpt-4o

# =========================
# GLM（智谱）配置
# =========================
# 必填：智谱 API Key
GLM_API_KEY=your-glm-api-key
# 选填：聊天模型，留空将使用示例脚本默认值 glm-4
GLM_MODEL=glm-4
